# -----------------------------------------------------------------------------
# This application needs NO runtime secrets.
#
# It is a browser SPA (public OAuth client, PKCE). Its Auth0 configuration
# (domain, clientId, audience, appUrl) is public by design and already baked into
# src/environments/environment.ts by the bookins PaaS provisioner.
#
# Sensitive Auth0 Action secrets live ONLY inside the Auth0 tenant and the
# bookins backend. They never appear here or anywhere in this repository.
#
# The variables below are OPTIONAL and only used by deploy.sh (build/push/apply).
# They are not secrets.
# -----------------------------------------------------------------------------

# Container image tag to build/push/deploy.
IMAGE=ghcr.io/rob-grokism/idrn-fe:latest

# Kubernetes namespace to deploy into.
NAMESPACE=bookins-paas

# App slug (used for k8s resource names).
APP_SLUG=idrn
